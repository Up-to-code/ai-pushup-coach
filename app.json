{
  "expo": {
    "name": "AI Push-Up Coach",
    "slug": "ai-pushup-coach",
    "scheme": "aipushupcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030700"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aipushupcoach.app",
      "appleTeamId": "U7JF269T76",
      "infoPlist": {
        "NSCameraUsageDescription": "AI Push-Up Coach uses the camera during live workouts to track push-up movement and count reps.",
        "NSMicrophoneUsageDescription": "Microphone access is not used for workout tracking."
      }
    },
    "android": {
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
