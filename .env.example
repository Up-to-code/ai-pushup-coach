# Expo/mobile public configuration
EXPO_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site
EXPO_PUBLIC_WEB_URL=https://www.pushcounter.online
EXPO_PUBLIC_AUTH_BASE_URL=https://your-convex-deployment.convex.site
EXPO_PUBLIC_ASSOCIATED_DOMAIN=pushcounter.online
# Set to true only when the Apple provisioning profile has Associated Domains enabled.
EXPO_PUBLIC_ENABLE_ASSOCIATED_DOMAINS=false
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your_revenuecat_public_sdk_key
EXPO_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID=pro

# Next.js web configuration
NEXT_PUBLIC_WEB_URL=https://www.pushcounter.online
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
CONVEX_SITE_URL=https://your-convex-deployment.convex.site
NEXT_PUBLIC_IOS_BUNDLE_ID=com.ahmedmansour.pushcounter
NEXT_PUBLIC_APPLE_TEAM_ID=U7JF269T76
NEXT_PUBLIC_SUPPORT_EMAIL=support@nexfiy.com

# Convex/server secrets live in Convex env, not in the client bundle:
