# Dependencies are installed by EAS.
node_modules/

# Expo/local caches
.expo/
dist/
web-build/
.next/
web/.next/
expo-env.d.ts
*.tsbuildinfo

# Native build products and generated dependency folders.
# Keep ios/ itself in the EAS archive because this app has custom native iOS
# code for camera tracking and widgets.
ios/build/
ios/Pods/
android/

# Local secrets and signing material
.env*.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Logs / OS files
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.metro-health-check*
